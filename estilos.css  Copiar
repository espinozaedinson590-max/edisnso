body {
    font-family: Arial, sans-serif;
    background-color: #f0f4f8;
    color: #333333;
    text-align: center;
    margin: 0;
    padding: 30px;
}

h1 {
    background-color: #003366;
    color: white;
    padding: 25px;
    border-radius: 10px;
}

h2 {
    color: #003366;
}

p {
    font-size: 18px;
    line-height: 1.6;
}

footer {
    background-color: #003366;
    color: white;
    padding: 15px;
    margin-top: 30px;
    border-radius: 10px;
}
